datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  gameResults  GameResult[]

  @@map("users")
}

model GameResult {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalTime         Float
  rawTime           Float
  penaltyTime       Float
  wrongAttempts     Int
  correctCharacters Int
  accuracy          Float
  isBestScore       Boolean          @default(false)
  completedAt       DateTime         @default(now())
  keystrokeEvents   KeystrokeEvent[]
  telemetry         GameTelemetry?

  @@index([totalTime(sort: Asc)])
  @@index([userId, completedAt(sort: Desc)])
  @@index([userId, totalTime(sort: Asc)])
  @@map("game_results")
}

model KeystrokeEvent {
  id           String     @id @default(uuid())
  gameResultId String
  gameResult   GameResult @relation(fields: [gameResultId], references: [id], onDelete: Cascade)
  key          String
  correct      Boolean
  timeMs       Float
  intervalMs   Float?
  finger       String?

  @@index([gameResultId])
  @@map("keystroke_events")
}

model GameTelemetry {
  id              String   @id @default(uuid())
  gameResultId    String   @unique
  gameResult      GameResult @relation(fields: [gameResultId], references: [id], onDelete: Cascade)
  avgWpm          Float
  peakWpm         Float
  consistency     Float
  avgInterval     Float
  intervalVariance Float
  flagged         Boolean  @default(false)
  flagReason      String?

  @@map("game_telemetry")
}
